# x-digest API environment. TEMPLATE ONLY — copy to /etc/xdigest/api.env
# (root-only, mode 600) and replace the placeholders with real values.
# Never commit a real password.
XDIGEST_ADDR=127.0.0.1:18090
XDIGEST_DSN=xdigest:XDIGEST_DB_PASSWORD@tcp(127.0.0.1:3306)/xdigest
XDIGEST_ATTACHMENT_DIR=/var/lib/xdigest/attachments

# Translation (DeepSeek via an OpenAI-compatible relay). Unset
# TRANSLATE_API_KEY disables POST /api/v1/translate (503); the UI
# 中文/EN toggle still works because UI strings are local.
TRANSLATE_API_BASE=https://api.apikey.fan
TRANSLATE_API_KEY=
TRANSLATE_MODEL=deepseek-flash

# Write-access token (cmd/api/auth.go). Every POST/PUT/PATCH/DELETE must send
# "X-API-Token: <value>" (or "Authorization: Bearer <value>"). Leave empty only
# for local development. Generate with: openssl rand -hex 32
API_TOKEN=

# Optional knobs (2026-10-28):
# AI_DAILY_LIMIT=300        max AI-spending requests per day, all clients (0 = unlimited)
# SUMMARY_CONCURRENCY=2     AI summaries running at once (1-16)
