# x-digest API environment. TEMPLATE ONLY — copy to /etc/xdigest/api.env
# (root-only, mode 600) and replace the placeholders with real values.
# Never commit a real password.
XDIGEST_ADDR=127.0.0.1:18090
XDIGEST_DSN=xdigest:XDIGEST_DB_PASSWORD@tcp(127.0.0.1:3306)/xdigest
XDIGEST_ATTACHMENT_DIR=/var/lib/xdigest/attachments
