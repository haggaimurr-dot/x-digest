[Unit]
Description=x-digest Go API
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/xdigest/backend
ExecStart=/opt/xdigest/backend/xdigest-api
EnvironmentFile=/etc/xdigest/api.env
Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
