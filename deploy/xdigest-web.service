[Unit]
Description=x-digest Nuxt frontend
After=network.target xdigest-api.service
Wants=xdigest-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/xdigest/frontend
# NOTE: the node binary path is filled in at deploy time from `command -v node`
# on the server (system node). PORT is what Nitro honours (NUXT_PORT does not).
Environment=PORT=18091
Environment=HOST=127.0.0.1
Environment=NUXT_SERVER_API_BASE=http://127.0.0.1:18090/api/v1
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=5
MemoryMax=1024M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
