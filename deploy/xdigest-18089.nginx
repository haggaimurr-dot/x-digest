# x-digest NEW stack (Nuxt + Go + MariaDB), public entry on 18089.
# Replaces the old static vhost (same file name, old content backed up on the
# server as x-digest-18089.static.bak). / goes to the Nuxt SSR server on
# 127.0.0.1:18091, /api/ goes to the Go API on 127.0.0.1:18093 (full path
# preserved: /api/v1/...). No /api rewriting: proxy_pass without a URI part.
#
# Security (2026-10-28):
#  - writes (any method but GET/HEAD) under /api/ need basic auth
#    (/etc/nginx/xdigest.htpasswd, create with `htpasswd -c`); the Go API also
#    checks API_TOKEN itself (backend/cmd/api/auth.go).
#  - rate limits per client IP: AI / import / sync paths 10 r/m, the rest of
#    /api/ 10 r/s. Over the limit nginx answers 429.
# This file is included in the http{} context, so the zones can live here.
limit_req_zone $binary_remote_addr zone=xd_ai:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=xd_api:10m rate=10r/s;
limit_req_status 429;

server {
    listen 18089;
    server_name _;
    client_max_body_size 110m;

    # AI-spending and long-running endpoints: summaries, import, refresh,
    # translate, repo/video sync.
    location ~ ^/api/v1/(posts/import|x/refresh|translate|repos/sync-all|yt/sync|bili/sync|posts/[^/]+/summary|(yt|bili)/videos/[^/]+/summary) {
        limit_req zone=xd_ai burst=5 nodelay;
        limit_except GET HEAD {
            auth_basic "xdigest";
            auth_basic_user_file /etc/nginx/xdigest.htpasswd;
        }
        proxy_pass http://127.0.0.1:18093;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # Server-sent events for summary progress: no buffering.
    location ~ ^/api/v1/.+/summary/stream$ {
        proxy_pass http://127.0.0.1:18093;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    location /api/ {
        limit_req zone=xd_api burst=40 nodelay;
        limit_except GET HEAD {
            auth_basic "xdigest";
            auth_basic_user_file /etc/nginx/xdigest.htpasswd;
        }
        proxy_pass http://127.0.0.1:18093;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # Prometheus metrics are for the server itself only.
    location = /api/v1/metrics { deny all; }

    location / {
        proxy_pass http://127.0.0.1:18091;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
